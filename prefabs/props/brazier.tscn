[sub_resource type="Shader" id="Shader_3pqlk"]
code = "shader_type spatial;
render_mode unshaded;

uniform sampler2D tex;
uniform vec3 offset;

void vertex() {
	float noise_value = texture(tex, VERTEX.xz / 2.0 + 0.5 * TIME * 3.0).x;
	VERTEX += noise_value * offset.x;
	VERTEX -= offset;
}

void fragment() {
	ALBEDO = texture(tex, UV + TIME * 0.2).rgb;
}

//void light() {
//	// Called for every pixel for every light affecting the material.
//	// Uncomment to replace the default light processing function with this one.
//}
"

