[sub_resource type="GDScript" id="GDScript_luoa5"]
script/source = "extends Node3D

@onready var chr := $CharacterBody3D as CharacterBody3D
@onready var nav_agent := $CharacterBody3D/NavigationAgent3D as NavigationAgent3D
@onready var camera := $Camera3D as Camera3D

var target_pos := Vector3()
var has_target := false

func _ready() -> void:
	#chr.velocity = Vector3(1, 0, 0)
	#nav_agent.target_position = $Marker3D.global_position
	#nav_agent.target_position.y = chr.global_position.y
	pass
	
func _physics_process(_delta: float) -> void:
	#var current_pos := chr.global_position
	#var next_path_pos := nav_agent.get_next_path_position()
	#print(next_path_pos)
	#chr.velocity = (current_pos.direction_to(next_path_pos) * 1.0)
	##print(chr.velocity)
	#chr.move_and_slide()
	##chr.apply_floor_snap()
	
	if has_target:
		nav_agent.target_position = target_pos
		var next_path_pos := nav_agent.get_next_path_position()
		var dir := chr.global_position.direction_to(next_path_pos)
		chr.velocity = dir * 5.0
		
		if nav_agent.is_navigation_finished():
			has_target = false
			target_pos = Vector3()
	else:
		chr.velocity = Vector3.ZERO
			
	chr.move_and_slide()
	
func _input(event: InputEvent) -> void:
	if event.is_action_pressed(&\"click\"):
		var ray := mouse_screen_to_world(camera, 1)
		if ray:
			target_pos = ray[\"position\"]
			has_target = true

func mouse_screen_to_world(cam: Camera3D, mask: int) -> Dictionary:
	var mouse_position := cam.get_viewport().get_mouse_position()
	var ray_origin := cam.project_ray_origin(mouse_position)
	var ray_end := ray_origin + cam.project_ray_normal(mouse_position) * 1000
	
	var space_state := cam.get_world_3d().direct_space_state
	var query := PhysicsRayQueryParameters3D.new()
	query.from = ray_origin
	query.to = ray_end
	query.collision_mask = mask
	var raycast := space_state.intersect_ray(query)
	return raycast
	
"

