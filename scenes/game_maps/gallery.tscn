[sub_resource type="GDScript" id="GDScript_sj1sr"]
script/source = "extends Node

@export var path: Path3D
@export var player: Player
@export var music: AudioStreamPlayer

var player_in_area := false

@onready var curve_length := path.curve.get_baked_length()

func _process(_delta: float) -> void:
	if player_in_area:
		var local_pos := path.to_local(player.global_position)
		var point_pos := path.curve.get_closest_offset(local_pos)
		var point_progress := point_pos / curve_length
		music.volume_db = lerp(-8.0, -59.0, point_progress)
		
		var reverb := AudioServer.get_bus_effect(1, 0) as AudioEffectReverb
		reverb.dry = 1.0 - point_progress
		reverb.wet = point_progress

func _on_music_controller_area_body_entered(_body: Node3D) -> void:
	player_in_area = true

func _on_music_controller_area_body_exited(_body: Node3D) -> void:
	player_in_area = false
	
	music.volume_db = -8.0
	var reverb := AudioServer.get_bus_effect(1, 0) as AudioEffectReverb
	reverb.dry = 1.0
	reverb.wet = 0.0
"

