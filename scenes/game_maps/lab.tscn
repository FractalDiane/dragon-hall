[sub_resource type="GDScript" id="GDScript_kk7dw"]
script/source = "extends Area3D

@export var anim_player: AnimationPlayer
@export var land_marker: Marker3D

func _on_body_entered(body: Node3D) -> void:
	if PlayerStateSubsystem.get_current_form() == PlayerStateSubsystem.FORM_DRAGONSMALL:
		PlayerStateSubsystem.push_block_movement_source()
		(body as Player).stop_immediately()

		anim_player.play(&\"barrier\")

		var tween := create_tween()
		tween.tween_property(body, ^\"rotation_degrees:z\", 920.0, 1.0)
		
		var tween2 := create_tween()
		tween2.tween_property(body, ^\"global_position\", ((body.global_position + land_marker.global_position) / 2) + Vector3(0, 1, 0), 0.5)
		tween2.tween_property(body, ^\"global_position\", land_marker.global_position, 0.5)

		await tween2.finished
		await get_tree().create_timer(1.0).timeout

		var event := EventPlaybackSubsystem.play_event(preload(\"res://dialogue/global/deaths.res\"), self, (body as Player).current_camera_zone.default_text_box_size, \"\", \"\", {&\"death_type\": \"lab_ward\"})
		await event.event_finished
		PlayerStateSubsystem.pop_block_movement_source()
"

