[sub_resource type="GDScript" id="GDScript_3s6tm"]
script/source = "extends Area3D

@onready var sound_slip := get_tree().current_scene.get_node(^\"SoundLakeSlip\") as AudioStreamPlayer3D
@onready var sound_sploosh := get_tree().current_scene.get_node(^\"SoundLakeSploosh\") as AudioStreamPlayer3D
@onready var lake_center := get_tree().current_scene.get_node(^\"LakeCenter\") as Marker3D

func _on_body_entered(body: Node3D) -> void:
	PlayerStateSubsystem.push_block_movement_source()
	(body as Player).stop_immediately()
	
	sound_slip.global_position = body.global_position
	sound_slip.play()
	
	var tween := create_tween()
	tween.tween_property(body, ^\"rotation_degrees:z\", 920.0, 1.0)
	
	var tween2 := create_tween()
	tween2.tween_property(body, ^\"global_position\", ((body.global_position + lake_center.global_position) / 2) + Vector3(0, 1, 0), 0.5)
	tween2.tween_property(body, ^\"global_position\", lake_center.global_position, 0.5)
	
	await tween2.finished
	sound_sploosh.play()
	await get_tree().create_timer(1.0).timeout
	
	var event := EventPlaybackSubsystem.play_event(preload(\"res://dialogue/global/deaths.res\"), self, (body as Player).current_camera_zone.default_text_box_size, \"\", \"\", {&\"death_type\": \"lake\"})
	await event.event_finished
	
	print(\"TEST\")
	
	#await get_tree().create_timer(1.0).timeout
	
	
	#var fireball := preload(\"res://prefabs/misc/fireball.tscn\").instantiate() as Node3D
	#get_tree().current_scene.add_child(fireball)
	#fireball.global_position = global_position
	
	#var tween := create_tween()
	#tween.tween_property(fireball, ^\"global_position\", body.global_position, 0.35)
	#await tween.finished
	
	#fireball.queue_free()
"

