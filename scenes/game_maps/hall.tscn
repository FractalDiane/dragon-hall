[sub_resource type="GDScript" id="GDScript_phxr3"]
script/source = "extends Area3D

func _on_body_entered(body: Node3D) -> void:
	PlayerStateSubsystem.push_block_movement_source()
	(body as Player).stop_immediately()
	await get_tree().create_timer(1.0).timeout
	
	var fireball := preload(\"res://prefabs/misc/fireball.tscn\").instantiate() as Node3D
	get_tree().current_scene.add_child(fireball)
	fireball.global_position = global_position
	
	var tween := create_tween()
	tween.tween_property(fireball, ^\"global_position\", body.global_position, 0.35)
	await tween.finished
	
	fireball.queue_free()
"

