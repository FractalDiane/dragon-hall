[sub_resource type="Shader" id="Shader_lk4or"]
code = "shader_type spatial;
render_mode unshaded;

uniform vec3 color : source_color;
uniform sampler2D noise_texture;

void vertex() {
	// Called for every vertex the material is visible on.
}

void fragment() {
	vec3 albedo = color * texture(noise_texture, UV + TIME * 0.04).rgb;
	ALBEDO = albedo;
	EMISSION = albedo * 0.1;
	ALPHA = 0.02;
}
"

