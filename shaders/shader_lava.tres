[gd_resource type="ShaderMaterial" format=3 uid="uid://c7f2c6uoggm02"]

[sub_resource type="Shader" id="Shader_lft5i"]
code = "shader_type spatial;

uniform sampler2D lava_texture;
instance uniform vec2 speed_factor = vec2(0.012);
instance uniform vec2 uv_scale = vec2(1.0);
uniform sampler2D noise;

void vertex() {
	float noise_value = texture(noise, VERTEX.xz / 2.0 + 0.5 * TIME * 0.05).x;
	VERTEX.y += noise_value * 0.5;
}

void fragment() {
	ALBEDO = texture(lava_texture, (UV * uv_scale) + TIME * speed_factor).rgb;
	EMISSION = ALBEDO;
}
"

